{
  "package": "com.democart.app",
  "description": "Demo Cart journey (mirrors lulu_search, the product page and lulu_cart): search, results, product page with scrolls, add to cart, cart with scrolls, checkout with the slot sheet, then pick a slot and capture the payment section. Stops before placing an order.",
  "steps": [
    { "action": "launch", "fresh": true, "wait": 5 },
    { "action": "tap", "id": "search_field", "seek": false, "wait": 2 },
    { "action": "capture", "label": "search", "still": false },
    { "action": "type", "into_id": "search_input", "text": "iphone", "wait": 2 },
    { "action": "capture", "label": "search", "still": false },
    { "action": "tap", "text": "Search for \"iphone\"", "seek": false, "wait": 2 },
    { "action": "capture", "label": "results" },
    { "action": "tap", "match": "iPhone", "pick": "first", "seek": false, "wait": 3 },
    { "action": "capture", "label": "pdp" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "pdp" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "pdp" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "pdp" },
    { "action": "tap", "id": "pdp_add", "seek": false, "wait": 2 },
    { "action": "capture", "label": "pdp_added" },
    { "action": "back", "wait": 2 },
    { "action": "back", "wait": 2 },
    { "action": "tap", "id": "view_cart", "seek": false, "wait": 3 },
    { "action": "capture", "label": "cart" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "cart" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "cart" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "cart" },
    { "action": "tap", "id": "go_checkout", "seek": false, "wait": 3 },
    { "action": "capture", "label": "checkout" },
    { "action": "tap", "text": "8 – 10 PM", "seek": false, "wait": 1 },
    { "action": "tap", "id": "slot_confirm", "seek": false, "wait": 2 },
    { "action": "capture", "label": "payment" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "payment" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "payment" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "payment" }
  ]
}