{
  "package": "com.democart.app",
  "description": "Demo Cart Minutes store (mirrors lulu_minutes).",
  "steps": [
    { "action": "launch", "fresh": true, "wait": 5 },
    { "action": "tap", "id": "store_minutes", "seek": false, "wait": 3 },
    { "action": "capture", "label": "minutes" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "minutes" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "minutes" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "minutes" },
    { "action": "swipe", "from_dp": [196, 600], "to_dp": [196, 160], "ms": 900, "wait": 2 },
    { "action": "capture", "label": "minutes" }
  ]
}