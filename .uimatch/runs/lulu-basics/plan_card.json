{
  "name": "home-card",
  "source": {"capture": "latest:lulu_home", "screen": "home_01"},
  "dest":   {"capture": "latest:democart_home", "screen": "home_01"},
  "anchor": "card",
  "parts": [
    {"name": "card", "kind": "box", "source": {"match": "^Samsung Front Load", "pick": "largest"}, "dest": {"match": "% OFF", "within": [0, 150, 140, 700], "pick": "first"},
     "checks": ["w", "h"]},
    {"name": "well", "kind": "box", "source": {"exact": "10% OFF", "pick": "largest"}, "dest": {"in_part": "card", "offset_dp": [1.1, 1.1, 116, 116.4]},
     "checks": ["w", "h"]},
    {"name": "badge", "kind": "text", "letters": "upper",
     "source": {"in_part": "card", "offset_dp": [14, 6, 62, 28]}, "dest": {"in_part": "card", "offset_dp": [14, 6, 62, 28]},
     "checks": ["ink_h", "weight", "color"]},
    {"name": "name", "kind": "text", "letters": "lower",
     "source": {"in_part": "card", "offset_dp": [6, 121, 112, 154]}, "dest": {"in_part": "card", "offset_dp": [6, 121, 112, 154]},
     "checks": ["ink_h", "weight"]},
    {"name": "price", "kind": "text", "letters": "upper",
     "source": {"in_part": "card", "offset_dp": [19, 162, 78, 182]}, "dest": {"in_part": "card", "offset_dp": [19, 162, 78, 182]},
     "checks": ["ink_h", "weight", "color"]}
  ],
  "tolerance": {"w": 3, "h": 4, "ink_h": 0.8}
}
